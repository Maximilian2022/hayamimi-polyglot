{
  "app_name": "Hayamimi Polyglot",
  "version": "1.0.1",
  "network": {
    "host": "127.0.0.1",
    "port": 8844,
    "allow_external": false
  },
  "security": {
    "stealth_mode_default": true,
    "record_audio_to_disk": false,
    "log_raw_transcripts": false,
    "clean_on_exit": true
  },
  "asr": {
    "model": "ReazonSpeech + Parakeet TDT v3 + SenseVoice",
    "high_accuracy_mode": true,
    "threads": 2,
    "vad_threshold": 0.45
  },
  "translation": {
    "default_languages": [
      "ja",
      "en"
    ],
    "max_concurrent_languages": 5,
    "models": {
      "multilingual": "mojicast-m2m100-ct2",
      "fast_ja_en": "mojicast-fugumt-ja-en-ct2"
    }
  },
  "ui": {
    "theme": "dark",
    "overlay_opacity": 0.82,
    "overlay_max_lines": 4,
    "click_through_default": false,
    "font_family": "",
    "font_size": 18,
    "overlay_width": 840,
    "overlay_height": 190,
    "colors": {
      "self_tag": "#38BDF8",
      "remote_tag": "#A78BFA",
      "orig_text": "#FFFFFF",
      "ja": "#34D399",
      "en": "#FBBF24",
      "zh": "#F472B6",
      "ko": "#A78BFA",
      "fr": "#60A5FA",
      "de": "#F87171",
      "es": "#FB923C",
      "trans_default": "#FBBF24"
    }
  },
  "audio": {
    "selected_mic_name": "",
    "selected_languages": [
      "ja",
      "en"
    ]
  }
}
